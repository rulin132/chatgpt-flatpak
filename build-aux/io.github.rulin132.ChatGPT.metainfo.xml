    <release version="26.820.71523" date="2026-08-27"/>
    <release version="26.820.60940" date="2026-08-26"/>
    <release version="26.818.61809" date="2026-08-25"/>
    <release version="26.818.41705" date="2026-08-23"/>
  </releases>
</component>
