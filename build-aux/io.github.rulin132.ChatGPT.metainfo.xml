<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.rulin132.ChatGPT</id>
  <name>ChatGPT</name>
  <summary>ChatGPT, Work and Codex desktop app</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary</project_license>

  <developer id="com.openai">
    <name>OpenAI</name>
  </developer>

  <description>
    <p>
      An unofficial Flatpak packaging of OpenAI's official ChatGPT desktop app
      for Linux, which upstream ships only as .deb and .rpm. The application
      binary is downloaded from OpenAI at install time and is not redistributed
      by this package.
    </p>
    <p>
      This packaging exists for distributions upstream does not serve: Fedora
      atomic desktops (Silverblue, Bluefin, Bazzite, Aurora, Kinoite), openSUSE
      Aeon/MicroOS, Arch, NixOS, Alpine and Steam Deck.
    </p>
    <p>
      It ships a sealed sandbox by default: no host filesystem access and no
      host command execution. Grant directories explicitly with
      <code>flatpak override</code>.
    </p>
  </description>

  <launchable type="desktop-id">io.github.rulin132.ChatGPT.desktop</launchable>
  <url type="homepage">https://openai.com/codex/</url>
  <url type="help">https://help.openai.com</url>
  <url type="bugtracker">https://github.com/rulin132/chatgpt-flatpak/issues</url>
  <url type="vcs-browser">https://github.com/rulin132/chatgpt-flatpak</url>

  <screenshots>
    <screenshot type="default">
      <caption>The Codex workspace view</caption>
      <image>https://raw.githubusercontent.com/rulin132/chatgpt-flatpak/main/docs/screenshots/codex-home.png</image>
    </screenshot>
  </screenshots>

  <branding>
    <color type="primary" scheme_preference="light">#ececf1</color>
    <color type="primary" scheme_preference="dark">#343541</color>
  </branding>

  <keywords>
    <keyword>ChatGPT</keyword>
    <keyword>Codex</keyword>
    <keyword>AI</keyword>
    <keyword>assistant</keyword>
    <keyword>chatbot</keyword>
  </keywords>

  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">intense</content_attribute>
    <content_attribute id="social-info">intense</content_attribute>
  </content_rating>

  <requires>
    <display_length compare="ge">768</display_length>
  </requires>

  <!-- Rewritten by scripts/sync-version.sh, which scripts/refresh-source.sh
